# ScreenMind Configuration
# Copy this to .env and adjust as needed

# ── LLM API Configuration (OpenAI-compatible) ───────────────────────────────
# Base URL for your LLM API endpoint (e.g., Ollama, vLLM, or cloud provider)
LLM_API_BASE_URL=http://localhost:11434/v1

# API key for your LLM endpoint (leave empty if not required, e.g., local Ollama)
# LLM_API_KEY=your-api-key-here

# Model name/identifier to use with your LLM API
LLM_MODEL_NAME=gemma4:e2b

# ── Capture Settings ─────────────────────────────────────────────────────────
CAPTURE_INTERVAL=40
SCREENSHOT_QUALITY=70
DATA_DIR=~/.screenmind

# ── Performance & Analysis ───────────────────────────────────────────────────
# Performance mode: minimal, balanced, or maximum
PERFORMANCE_MODE=balanced

# Analysis mode: fast, balanced, or accurate
ANALYSIS_MODE=fast

# ── Embedding Model (always local) ───────────────────────────────────────────
# MiniLM-L6-v2 runs locally for semantic search - no configuration needed

# ── Developer Context ────────────────────────────────────────────────────────
WORKSPACE_DIRS=~/Projects,~/Desktop

# ── Privacy ──────────────────────────────────────────────────────────────────
BLOCKED_APPS=

# ── Hotkeys ──────────────────────────────────────────────────────────────────
BOOKMARK_HOTKEY=ctrl+shift+b
PAUSE_HOTKEY=ctrl+shift+p
VOICE_HOTKEY=ctrl+shift+v
